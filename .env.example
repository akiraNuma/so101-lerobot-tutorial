# ============================================================
# SO-101 の環境設定
#
# このファイルを .env にコピーして、自分の環境の値に書き換える:
#   cp .env.example .env
#
# ポートとカメラの番号は次のコマンドで調べられる:
#   bash scripts/find_devices.sh
# ============================================================

# --- USB ポート ---
# macOS : /dev/tty.usbmodem...
# Linux : /dev/ttyACM0
FOLLOWER_PORT=/dev/tty.usbmodemXXXXXXXX
LEADER_PORT=/dev/tty.usbmodemYYYYYYYY

# --- アームの ID ---
# キャリブレーションファイルの名前になる。好きな名前でよい
FOLLOWER_ID=my_follower_arm
LEADER_ID=my_leader_arm

# --- カメラの番号 ---
# overhead = 俯瞰（上から見下ろし）、wrist = 手元（グリッパー付近）
# Linux では /dev/video0 のようなパスになる
OVERHEAD_CAMERA_INDEX=1
WRIST_CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
